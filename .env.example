# Copied to .env by `make init`. Real secrets never go in this file.

DJANGO_SECRET_KEY=dev-only-insecure-key-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres runs in Docker (`make db`). Host port 5433 avoids clashing with
# another local Postgres on 5432.
POSTGRES_USER=ledger
POSTGRES_PASSWORD=ledger
POSTGRES_DB=ledger
POSTGRES_PORT=5433
DATABASE_URL=postgres://ledger:ledger@localhost:5433/ledger
